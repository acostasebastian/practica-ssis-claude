    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Flujo0]" DTS:LogicalAnd="True" DTS:From="Package\ComprobarEntorno" DTS:To="Package\CargarVentas" DTS:Value="0" DTS:DTSID="{F020DC13-FC39-4E3E-8F35-DB55C2B71B67}" DTS:ObjectName="Flujo0" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Flujo1]" DTS:LogicalAnd="True" DTS:From="Package\CargarVentas" DTS:To="Package\ComprobarBalance" DTS:Value="0" DTS:DTSID="{F9BF1E52-3AD6-4937-8073-2D76E998F76B}" DTS:ObjectName="Flujo1" />
