  <DTS:Executables>
    <DTS:Executable DTS:DTSID="{5E40DE96-61B8-4C34-92E5-58BCA9BCDBA2}" DTS:LocaleID="3082" DTS:ObjectName="ComprobarEntorno" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:TransactionOption="1" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:refId="Package\ComprobarEntorno" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'ClaudeETLLab' THROW 51010,'Base de datos incorrecta.',1; IF OBJECT_ID(N'dbo.usp_CargarVentas',N'P') IS NULL THROW 51011,'Ejecuta primero los scripts de preparacion.',1;" SQLTask:TimeOut="120" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" SQLTask:Connection="{B2D2B4C9-5B72-4B0C-80D6-2248EF642A6B}" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:DTSID="{8F9D11FB-A2D0-43AD-9C84-A91898EF5379}" DTS:LocaleID="3082" DTS:ObjectName="CargarVentas" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:TransactionOption="1" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:refId="Package\CargarVentas" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:SqlStatementSource="EXEC dbo.usp_CargarVentas @Archivo = ?;" SQLTask:TimeOut="120" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" SQLTask:Connection="{B2D2B4C9-5B72-4B0C-80D6-2248EF642A6B}" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::Archivo" SQLTask:DataType="130" SQLTask:ParameterSize="4000" SQLTask:ParameterDirection="Input" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:DTSID="{2D1F13C7-8326-44ED-8B1A-402E9B59CF63}" DTS:LocaleID="3082" DTS:ObjectName="ComprobarBalance" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:TransactionOption="1" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:refId="Package\ComprobarBalance" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:SqlStatementSource="IF EXISTS(SELECT 1 FROM dbo.Ejecuciones WHERE Estado='CORRECTA' AND (Leidas&lt;&gt;Aceptadas+Rechazadas OR Insertadas+Actualizadas&gt;Aceptadas)) THROW 51012,'Balance de filas incorrecto.',1;" SQLTask:TimeOut="120" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" SQLTask:Connection="{B2D2B4C9-5B72-4B0C-80D6-2248EF642A6B}" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
