  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:DTSID="{B2D2B4C9-5B72-4B0C-80D6-2248EF642A6B}" DTS:refId="Package.ConnectionManagers[Laboratorio]" DTS:ObjectName="Laboratorio" DTS:CreationName="OLEDB">
      <DTS:PropertyExpression DTS:Name="ConnectionString">@[User::ConnectionString]</DTS:PropertyExpression>
